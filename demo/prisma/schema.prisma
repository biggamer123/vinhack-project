// Analytics database - page views and daily rollups.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

model PageView {
  id        String   @id @default(uuid())
  postId    BigInt
  referrer  String?
  country   String?
  viewedAt  DateTime @default(now())
}

model DailyStat {
  id        String   @id @default(uuid())
  postId    BigInt
  day       DateTime
  views     Int
  readers   Int
  comments  Int
}
